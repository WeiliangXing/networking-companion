{
  "name": "william-networking-companion",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/business/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "networking-companion",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "REALTIME_MODEL": "gpt-realtime-2.1",
    "SEARCH_MODEL": "gpt-5.4",
    "PUBLIC_DEMO": "false"
  }
}
